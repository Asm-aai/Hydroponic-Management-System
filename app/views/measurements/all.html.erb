<div class="container py-5">
  <h1 class="mb-4">計測値一覧</h1>

  <% if @measurements.any? %>
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>植物名</th>
          <th>計測種類</th>
          <th>値</th>
          <th>計測日</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @measurements.each do |m| %>
          <tr>
            <td><%= m.plant.name %></td>
            <td><%= I18n.t("activerecord.enums.measurement.measurement_type.#{m.measurement_type}") %></td>
            <td><%= m.value %></td>
            <td><%= l(m.measured_at, format: :long) %></td>
            <td>
              <%= link_to '編集', edit_plant_measurement_path(m.plant, m), class: "btn btn-sm btn-outline-secondary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="p-3 mb-0 text-center text-muted">計測値がまだありません</p>
  <% end %>
</div>