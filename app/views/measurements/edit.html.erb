<!-- app/views/measurements/edit.html.erb -->
<%= render "shared/error_messages", resource: @measurement %>

<div class="container py-5">
  <h2 class="mb-4">計測値を編集</h2>

  <%= form_with model: [@plant, @measurement], url: plant_measurement_path(@plant, @measurement), method: :patch, local: true do |f| %>
    <div class="mb-3">
      <%= f.label :measurement_type, "計測種類", class: "form-label" %>
      <%= f.select :measurement_type, Measurement.measurement_types.keys.map { |k| [I18n.t("activerecord.enums.measurement.measurement_type.#{k}"), k] }, {}, class: "form-select" %>

    </div>

    <div class="mb-3">
      <%= f.label :value, "値", class: "form-label" %>
      <%= f.number_field :value, step: 0.01, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :measured_at, "計測日", class: "form-label" %>
      <%= f.date_field :measured_at, class: "form-control", required: true %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "更新する", class: "btn btn-primary" %>
      <%= link_to "キャンセル", "javascript:history.back()", class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>