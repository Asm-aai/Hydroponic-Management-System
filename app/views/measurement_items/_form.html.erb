<%= form_with model: @measurement_item, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :name, "項目名" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :unit, "単位" %>
    <%= f.text_field :unit, class: "form-control" %>
  </div>

  <div>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>