<%= render "shared/error_messages", resource: @plant %>
<div class="container py-5">
  <div class="card mx-auto" style="max-width: 600px;">
    <div class="card-body">
      <h1 class="card-title mb-4 text-center">新規投稿</h1>

      <%= render "shared/error_messages", resource: @plant %>

      <%= form_with(model: @plant, data: { turbo: false }, local: true) do |f| %>
        
        <div class="mb-3">
          <%= f.label :name, "植物名", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :planted_at, "植えた日", class: "form-label" %>
          <%= f.date_field :planted_at, class: "form-control", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :harvested_at, "採取日", class: "form-label" %>
          <%= f.date_field :harvested_at, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :comment, "コメント", class: "form-label" %>
          <%= f.text_area :comment, class: "form-control", rows: 4, required: true %>
        </div>

        <div class="d-grid">
          <%= f.submit '投稿', class: "btn btn-primary btn-lg" %>
        </div>

      <% end %>
    </div>
  </div>
</div>