<%= render "shared/error_messages", resource: @plant %>

<div class="container py-5">
  <h1 class="mb-4">植物編集</h1>

  <%= form_with model: @plant, url: update_plant_path(@plant.id), method: :patch, local: true do |f| %>
    
    <div class="mb-3">
      <%= f.label :name, "植物名", class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :planted_at, "植えた日", class: "form-label" %>
      <%= f.date_field :planted_at, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :harvested_at, "採取日", class: "form-label" %>
      <%= f.date_field :harvested_at, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :comment, "コメント", class: "form-label" %>
      <%= f.text_area :comment, class: "form-control", rows: 4 %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "更新する", class: "btn btn-primary" %>
      <%= link_to "キャンセル", plant_path(@plant), class: "btn btn-secondary" %>
    </div>

  <% end %>
</div>