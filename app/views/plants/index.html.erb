<div class="container my-5">
  <h1 class="mb-4">栽培一覧</h1>

  <% @plants.each do |plant| %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <h2 class="h5">
          <%= link_to plant.name, plant_path(plant), class: "text-decoration-none" %>
        </h2>
        <p><strong>植えた日：</strong> <%= l(plant.planted_at, format: :long) %></p>
        <% if plant.harvested_at.present? %>
          <p><strong>採取日：</strong> <%= l(plant.harvested_at, format: :long) %></p>
        <% end %>
        <p><strong>コメント：</strong> <%= plant.comment %></p>
        <p><strong>価格：</strong> <%= number_to_currency(plant.price, unit: "円") %></p>

        <div class="mt-2">
          <%= link_to '詳細を見る', plant_path(plant), class: "btn btn-outline-primary btn-sm me-2" %>
          <% if admin_signed_in? %>
            <%= link_to '編集', edit_plant_path(plant), class: "btn btn-outline-secondary btn-sm" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <p class="mt-4">総栽培数: <strong><%= @plants.count %></strong> 件</p>

  <p><%= link_to '新しい栽培を追加', new_plant_path, class: "btn btn-success mt-3" %></p>
</div>