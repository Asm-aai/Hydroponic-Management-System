<div class="container my-5">
  <!-- 植物詳細カード -->
  <div class="card mb-4 shadow-sm">
    <div class="card-header">
      <h1 class="h3 mb-0"><%= @plant.name %></h1>
    </div>
    <div class="card-body">
      <p><strong>植えた日：</strong> <%= l(@plant.planted_at, format: :long) %></p>
      <% if @plant.harvested_at.present? %>
        <p><strong>採取日：</strong> <%= l(plant.harvested_at, format: :long) %></p>
      <% end %>
      <p><strong>メモ：</strong> <%= @plant.comment %></p>

      <div class="mt-3">
        <%= link_to '編集', edit_plant_path(@plant), class: "btn btn-primary me-2" %>
        <%= link_to '削除', plant_path(@plant), data: { turbo_method: :delete, confirm: '本当に削除しますか？' }, class: "btn btn-danger" %>
      </div>
    </div>
  </div>

  <%= link_to '栽培一覧へ戻る', plants_path, class: "btn btn-outline-secondary mb-4" %>

  <!-- 計測値一覧 -->
  <div class="card mb-4 shadow-sm">
    <div class="card-header">
      <h2 class="h5 mb-0"><%= @plant.name %> の計測値一覧</h2>
    </div>
    <div class="card-body p-0">

      <% if @plant.measurements.any? %>
        <table class="table table-striped table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>日付</th>
              <th>種類</th>
              <th>値</th>
              <th></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @plant.measurements.each do |m| %>
              <tr>
                <td><%= l(m.measured_at, format: :long) %></td>
                <td><%= I18n.t("activerecord.enums.measurement.measurement_type.#{m.measurement_type}") %></td>
                <td><%= m.value %></td>
                <td><%= link_to '編集', edit_plant_measurement_path(@plant, m), class: "btn btn-sm btn-primary" %></td>
                <td><%= link_to '削除', plant_measurement_path(@plant, m  ), data: { turbo_method: :delete, confirm: '本当に削除しますか？' }, class: "btn btn-sm btn-danger" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-3 text-center text-muted mb-0">計測値はまだありません。</p>
      <% end %>
    </div>
  </div>
  


  <!-- 計測値フォーム -->
  <div class="card shadow-sm">
    <div class="card-header">
      <h3 class="h5 mb-0">新しい計測を追加</h3>
    </div>
    <div class="card-body">
      <%= form_with model: [@plant, Measurement.new], local: true, class: "row g-3" do |f| %>
        <div class="col-md-4">
          <%= f.label :measurement_type, "種類", class: "form-label" %>
          <%= f.select :measurement_type, Measurement.measurement_types.keys.map { |k| [I18n.t("activerecord.enums.measurement.measurement_type.#{k}"), k] }, {}, class: "form-select" %>
        </div>

        <div class="col-md-4">
          <%= f.label :value, "値", class: "form-label" %>
          <%= f.number_field :value, step: 0.01, class: "form-control", required: true %>
        </div>

        <div class="col-md-4">
          <%= f.label :measured_at, "計測日", class: "form-label" %>
          <%= f.date_field :measured_at, class: "form-control", required: true %>
        </div>

        <div class="col-12">
          <%= f.submit "登録する", class: "btn btn-success mt-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>