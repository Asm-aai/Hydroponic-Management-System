<div class="container my-5">
  <!-- 植物詳細カード -->
  <div class="card mb-4 shadow-sm">
    <div class="card-header">
      <h1 class="h3 mb-0"><%= @plant.name %></h1>
    </div>
    <div class="card-body">
      <p><strong>植えた日：</strong> <%= l(@plant.planted_at, format: :long) %></p>
      <% if @plant.harvested_at.present? %>
        <p><strong>採取日：</strong> <%= l(plant.harvested_at, format: :long) %></p>
      <% end %>
      <p><strong>メモ：</strong> <%= @plant.comment %></p>

      <div class="mt-3">
        <%= link_to '編集', edit_plant_path(@plant), class: "btn btn-primary me-2" %>
        <%= link_to '削除', plant_path(@plant), data: { turbo_method: :delete, confirm: '本当に削除しますか？' }, class: "btn btn-danger" %>
      </div>
    </div>
  </div>

  <%= link_to '栽培一覧へ戻る', plants_path, class: "btn btn-outline-secondary mb-4" %>

  <!-- 計測値一覧 -->
  <div class="card mb-4 shadow-sm">
    <div class="card-header">
      <h2 class="h5 mb-0"><%= @plant.name %> の計測値一覧</h2>
    </div>
    <div class="card-body p-0">
      <% if @plant.measurements.any? %>
        <table class="table table-striped table-hover mb-0">
          <thead class="table-dark">
            <tr>
              <th>計測日</th>
              <th>温度</th>
              <th>湿度</th>
              <th>EC</th>
              <th>pH</th>
              <th>CO2</th>
              <% if admin_signed_in? %>
                <th>操作</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @plant.measurements.each do |m| %>
              <tr>
                <td><%= m.measured_at.present? ? l(m.measured_at, format: :long) : "-" %></td>
                <td><%= m.temperature %></td>
                <td><%= m.humidity %></td>
                <td><%= m.ec %></td>
                <td><%= m.ph %></td>
                <td><%= m.CO2 %></td>
                <% if admin_signed_in? %>
                  <td>
                    <%= link_to '編集', edit_admin_plant_measurement_path(@plant, m), class: "btn btn-sm btn-outline-secondary me-2" %>
                    <%= link_to '削除', admin_plant_measurement_path(@plant, m), data: { turbo_method: :delete, confirm: '本当に削除しますか？' }, class: "btn btn-sm btn-outline-danger" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-3 text-center text-muted mb-0">計測値はまだありません。</p>
      <% end %>
    </div>
  </div>
  


  <!-- 計測値フォーム -->
  <div class="card shadow-sm">

    <% if admin_signed_in? %>
      <div class="card-header">
        <h3 class="h5 mb-0">新しい計測を追加</h3>
      </div>
      <div class="card-body">
        <%= form_with url: admin_plant_measurements_path(@plant), local: true, class: "row g-3" do |f| %>

          <div class="col-md-4">
            <%= label_tag "measurement[temperature]", "温度", class: "form-label" %>
            <%= number_field_tag "measurement[temperature]", nil, step: 0.01, class: "form-control" %>
          </div>

          <div class="col-md-4">
            <%= label_tag "measurement[humidity]", "湿度", class: "form-label" %>
            <%= number_field_tag "measurement[humidity]", nil, step: 0.01, class: "form-control" %>
          </div>

          <div class="col-md-4">
            <%= label_tag "measurement[ec]", "EC", class: "form-label" %>
            <%= number_field_tag "measurement[ec]", nil, step: 0.01, class: "form-control" %>
          </div>

          <div class="col-md-4">
            <%= label_tag "measurement[ph]", "pH", class: "form-label" %>
            <%= number_field_tag "measurement[ph]", nil, step: 0.01, class: "form-control" %>
          </div>

          <div class="col-md-4">
            <%= label_tag "measurement[co2]", "CO2", class: "form-label" %>
            <%= number_field_tag "measurement[CO2]", nil, step: 0.01, class: "form-control" %>
          </div>

          <div class="col-md-4">
            <%= label_tag "measurement[measured_at]", "計測日", class: "form-label" %>
            <%= date_field_tag "measurement[measured_at]", Date.today, class: "form-control", required: true %>
            
          </div>

          <div class="col-12">
            <%= submit_tag "登録する", class: "btn btn-success mt-2" %>
          </div>

        <% end %>
      </div>
    <% end %>
  </div>
  
</div>