<div class="container my-5">
  <!-- 植物詳細カード -->
  <div class="card mb-4 shadow-sm">
    <div class="card-header">
      <h1 class="h3 mb-0"><%= @plant.name %></h1>
    </div>
    <div class="card-body">
      <% if @plant.image.attached? %>
        <p><%= image_tag @plant.image, style: "width: 100%; max-width: 800px; height: auto;" %></p>
        
      <% end %>
      <p><strong>植えた日：</strong> <%= l(@plant.planted_at, format: :long) %></p>
      <% if @plant.harvested_at.present? %>
        <p><strong>採取日：</strong> <%= l(plant.harvested_at, format: :long) %></p>
      <% end %>
      <p><strong>メモ：</strong> <%= @plant.comment %></p>
      <P><strong>価格：</strong> <%= number_to_currency(@plant.price, unit: "円") %></P>

      <% if user_signed_in? %>
        <%= form_with url: cart_items_path, method: :post do %>
          <%= hidden_field_tag :plant_id, @plant.id %>

          <div class="mb-3">
            <%= number_field_tag :quantity, 1, min: 1, class: "form-control" %>
          </div>

          <%= submit_tag "カートに入れる", class: "btn btn-primary" %>
        <% end %>
      <% elsif admin_signed_in? %>
        <div class="mt-3">
          <%= link_to '編集', edit_plant_path(@plant), class: "btn btn-primary me-2" %>
          <%= link_to '削除', plant_path(@plant), data: { turbo_method: :delete, confirm: '本当に削除しますか？' }, class: "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>

  <%= link_to '栽培一覧へ戻る', plants_path, class: "btn btn-outline-secondary mb-4" %>

  <!-- 計測値一覧 -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
      測定データ一覧
    </div>
    <div class="card-body, table-responsive">
      <% if Measurement.exists? %>
        <div class="table-responsive">

          <%# 縦表示 %>
          <table class="table table-bordered table-hover">
            <thead class="table-light">
              <tr>
                <th>項目</th>
                <% Measurement.order(:measured_at).each do |measurement| %>
                  <th><%= l(measurement.measured_at, format: :short) %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% MeasurementItem.all.each do |item| %>
                <tr>
                  <th><%= item.label %></th>
                  <% Measurement.order(:measured_at).each do |measurement| %>
                    <% mv = measurement.measurement_values.find { |v| v.measurement_item_id == item.id } %>
                    <td>
                      <% if item.label == "備考 / 特記事項" %>
                        <%= mv&.text_value %>
                      <% else %>
                        <%= mv&.value %>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# 横表示 %>
        <table class="table table-bordered table-hover">
          <thead class="table-light">
            <tr>
              <th>計測日</th>
              <% MeasurementItem.all.each do |item| %>
                <th><%= item.label %></th>
              <% end %>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% Measurement.all.each do |measurement| %>
              <tr>
                <td><%= measurement.measured_at %></td>
                <% MeasurementItem.all.each do |item| %>
                  <td>
                    <% mv = measurement.measurement_values.find { |v| v.measurement_item_id == item.id } %>
                    <% if item.label == "備考 / 特記事項" %>
                      <%= mv&.text_value %>
                    <% else %>
                      <%= mv&.value %>
                    <% end %>
                  </td>
                <% end %>
                <td class="text-nowrap">
                  <%= link_to "編集",
                    edit_plant_measurement_path(@plant, measurement),
                    class: "btn btn-sm btn-primary" %>

                  <%= link_to "削除",
                    plant_measurement_path(@plant, measurement),
                    data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                    class: "btn btn-sm btn-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="p-3 text-center text-muted mb-0">
          計測値はまだありません。
        </p>
      <% end %>
    </div>
  </div>

    <!-- 計測値フォーム -->
  <div class="card shadow-sm">
    <div class="card-header bg-success text-white">
      測定データ登録
    </div>
    <div class="card-body">
      <%= form_with model: [@plant, @measurement], local: true do |f| %>
        <div class="mb-3">
          <%= f.label :measured_at, "測定日", class: "form-label" %>
          <%= f.date_field :measured_at, class: "form-control" %>
        </div>
        <% MeasurementItem.all.each do |item| %>
          <div class="mb-3">
            <label class="form-label">
              <%= item.label %>（<%= item.unit %>）
              <small class="text-muted">
                目標: <%= item.min_value %>〜<%= item.max_value %>
              </small>
            </label>
            <%= f.fields_for :measurement_values, @measurement.measurement_values.build(measurement_item: item) do |mv| %>
              <%= mv.hidden_field :measurement_item_id, value: item.id %>
              <% if item.label == "備考 / 特記事項" %>
                <%= mv.text_area :text_value, class: "form-control", rows: 3 %>
              <% else %>
                <%= mv.number_field :value, step: 0.01, class: "form-control" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <div class="text-end">
          <%= f.submit "登録", class: "btn btn-success" %>
        </div
      <% end %>
    </div>
  </div>
  
</div>